# OPTIONAL LOCAL DEVELOPMENT EXAMPLE — DO NOT PUT REAL KEYS IN GIT.
# Defaults need no .env or secrets. node server.mjs starts a working offline-ready website.
HOST=127.0.0.1
PORT=3000
AI_DAILY_CALL_LIMIT=10
# OPENAI_MODEL=gpt-4.1-mini
# When you decide to test real services, configure these privately in your shell:
# OPENAI_API_KEY=SET_ONLY_IN_PRIVATE_ENVIRONMENT
# HH_CONTACT_EMAIL=SET_ONLY_IN_PRIVATE_ENVIRONMENT
# DEMO_ACCESS_CODE=SET_TO_A_PRIVATE_RANDOM_16_PLUS_CHARACTER_VALUE
# WARNING: This file is illustrative; server does not automatically load .env files.
# On Render use Dashboard -> Environment, not files in the repository.

